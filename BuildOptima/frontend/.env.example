# Mode API: 'mock' (data lokal di browser, tanpa backend) atau 'real' (pakai backend Express)
VITE_API_MODE=mock

# --- Mode real ---
# VITE_API_MODE=real
# Opsional: default '/api' (diteruskan oleh proxy Vite ke http://localhost:4000)
# VITE_API_BASE_URL=http://localhost:4000/api
# Opsional: URL Socket.IO backend. Default = origin halaman (proxy Vite meneruskan /socket.io)
# VITE_SOCKET_URL=http://localhost:4000
