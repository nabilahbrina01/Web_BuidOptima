# ============================================
# BuildOptima - Environment Configuration
# ============================================

# App
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Database (MySQL)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/buildoptima"

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d

# MQTT Broker
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=buildoptima-server

# Email (Nodemailer - for OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="BuildOptima <your_email@gmail.com>"

# File Upload
UPLOAD_PATH=uploads
MAX_FILE_SIZE_MB=10

# Energy Cost (IDR per kWh)
ELECTRICITY_RATE_IDR=1444.70

# Device Heartbeat Timeout (seconds)
DEVICE_TIMEOUT_SEC=30

# Simulator (set to true to run dummy sensor simulators)
ENABLE_SIMULATORS=false

# ENABLE_EMAIL_NOTIFICATIONS=true
# NOTIFY_EMAIL_COOLDOWN_MIN=30
# ENABLE_DAILY_REPORT=true
# DAILY_REPORT_TIME=07:00
# APP_URL=http://localhost:5173