// BuildOptima - Prisma Schema
// MySQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  staff
}

enum OccupancyStatus {
  occupied
  empty
}

enum DeviceStatus {
  online
  offline
}

enum AssetCondition {
  good
  damaged
  missing
}

enum AssetStatus {
  active
  inactive
}

enum ActuatorStatus {
  on
  off
}

enum NotificationType {
  device_offline
  energy_anomaly
  occupancy_alert
  system
}

model User {
  id          Int      @id @default(autoincrement())
  username    String   @unique @db.VarChar(100)
  email       String   @unique @db.VarChar(150)
  password    String   @db.VarChar(255)
  role        Role     @default(staff)
  email_verified Boolean @default(false)
  notif_email Boolean  @default(true)   // peringatan (perangkat offline, lonjakan daya) via email
  notif_push  Boolean  @default(true)   // notifikasi browser saat aplikasi terbuka
  notif_daily Boolean  @default(false)  // laporan harian via email
  daily_report_sent_at DateTime?        // kapan laporan harian terakhir dikirim (mencegah kirim ganda)
  name        String?  @db.VarChar(100)
  nip         String?  @db.VarChar(50)
  phone       String?  @db.VarChar(30)
  photo       String?  @db.MediumText // data-URL foto profil (hasil resize di frontend)
  otp_code    String?  @db.VarChar(10)
  otp_expired DateTime?
  created_at  DateTime @default(now())

  @@map("users")
}

model Room {
  id               Int             @id @default(autoincrement())
  room_code        String          @unique @db.VarChar(20)
  room_name        String          @db.VarChar(100)
  floor            Int
  capacity         Int             @default(40)
  occupancy_status OccupancyStatus @default(empty)
  created_at       DateTime        @default(now())

  schedules      Schedule[]
  devices        Device[]
  assets         Asset[]
  occupancy_logs OccupancyLog[]
  energy_logs    EnergyLog[]
  ai_results     InventoryAiResult[]

  @@map("rooms")
}

model Schedule {
  id          Int    @id @default(autoincrement())
  room_id     Int
  course_name String @db.VarChar(150)
  lecturer    String @db.VarChar(100)
  day         String @db.VarChar(10) // monday, tuesday, ...
  start_time  String @db.VarChar(8)  // HH:mm:ss
  end_time    String @db.VarChar(8)

  room Room @relation(fields: [room_id], references: [id], onDelete: Cascade)

  @@map("schedules")
}

model Device {
  id          Int          @id @default(autoincrement())
  esp_id      String       @unique @db.VarChar(64)
  room_id     Int?
  device_name String       @db.VarChar(100)
  device_type String       @default("AC") @db.VarChar(30)
  power_watt  Int          @default(0)
  status      DeviceStatus @default(offline)
  auto_mode   Boolean      @default(true)
  last_seen   DateTime?
  created_at  DateTime     @default(now())

  room      Room?      @relation(fields: [room_id], references: [id], onDelete: SetNull)
  sensors   Sensor[]
  actuators Actuator[]

  @@map("devices")
}

model Asset {
  id               Int            @id @default(autoincrement())
  room_id          Int?
  asset_name       String         @db.VarChar(150)
  category         String         @db.VarChar(80)
  condition        AssetCondition @default(good) // legacy internal enum, kept for compatibility
  condition_status String         @default("Baik") @db.VarChar(30) // 'Baik' | 'Ada Yang Rusak' | 'Rusak' — matches frontend dropdown exactly
  qty              Int            @default(1)
  note             String?        @db.VarChar(255)
  status           AssetStatus    @default(active)
  qr_code          String?        @db.VarChar(255)
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  room Room? @relation(fields: [room_id], references: [id], onDelete: SetNull)

  @@map("assets")
}

model Sensor {
  id          Int      @id @default(autoincrement())
  device_id   Int
  sensor_type String   @db.VarChar(50) // mmwave, dht22_temp, dht22_hum, pzem_voltage, etc.
  unit        String   @db.VarChar(20)
  created_at  DateTime @default(now())

  device Device      @relation(fields: [device_id], references: [id], onDelete: Cascade)
  logs   SensorLog[]

  @@map("sensors")
}

model SensorLog {
  id          Int      @id @default(autoincrement())
  sensor_id   Int
  value       Decimal  @db.Decimal(12, 4)
  recorded_at DateTime @default(now())

  sensor Sensor @relation(fields: [sensor_id], references: [id], onDelete: Cascade)

  @@index([sensor_id, recorded_at])
  @@map("sensor_logs")
}

model OccupancyLog {
  id          Int             @id @default(autoincrement())
  room_id     Int
  status      OccupancyStatus
  detected_at DateTime        @default(now())

  room Room @relation(fields: [room_id], references: [id], onDelete: Cascade)

  @@index([room_id, detected_at])
  @@map("occupancy_logs")
}

model EnergyLog {
  id             Int      @id @default(autoincrement())
  room_id        Int
  voltage        Decimal  @db.Decimal(8, 2)
  current        Decimal  @db.Decimal(8, 4)
  power          Decimal  @db.Decimal(10, 2)
  energy_kwh     Decimal  @db.Decimal(12, 6)
  estimated_cost Decimal  @db.Decimal(12, 2)
  recorded_at    DateTime @default(now())

  room Room @relation(fields: [room_id], references: [id], onDelete: Cascade)

  @@index([room_id, recorded_at])
  @@map("energy_logs")
}

model Actuator {
  id           Int            @id @default(autoincrement())
  device_id    Int
  actuator_name String        @db.VarChar(80)
  status       ActuatorStatus @default(off)
  updated_at   DateTime       @updatedAt

  device Device @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@map("actuators")
}

model Notification {
  id         Int              @id @default(autoincrement())
  title      String           @db.VarChar(150)
  message    String           @db.Text
  type       NotificationType @default(system)
  is_read    Boolean          @default(false)
  created_at DateTime         @default(now())

  @@map("notifications")
}

model InventoryAiResult {
  id               Int      @id @default(autoincrement())
  room_id          Int
  image_url        String   @db.VarChar(255)
  detected_objects Json
  expected_objects Json
  mismatch_count   Int      @default(0)
  created_at       DateTime @default(now())

  room Room @relation(fields: [room_id], references: [id], onDelete: Cascade)

  @@map("inventory_ai_results")
}

enum MaintenanceStatus {
  done
  pending
  cancelled
  in_progress
}

model MaintenanceLog {
  id           Int               @id @default(autoincrement())
  asset_id     Int?
  asset_name   String            @db.VarChar(150)
  room_id      Int?
  activity     String            @db.VarChar(150)
  technician   String?           @db.VarChar(100)
  status       MaintenanceStatus @default(pending)
  performed_at DateTime          @default(now())  // kapan jadwal dibuat
  scheduled_date DateTime?                         // rencana tanggal pengerjaan
  completed_at DateTime?                           // diisi saat status -> done
  notes        String?           @db.VarChar(500)  // catatan teknisi / hasil perawatan

  @@map("maintenance_logs")
}